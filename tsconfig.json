{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "jsx": "react-jsx",
        "paths": {
            "onejs-react": ["./node_modules/onejs-react/src"]
        },
        "types": ["unity-types", "react"]
    },
    "include": ["src", "dev"]
}
